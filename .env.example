# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgres://spotidata:spotidata@127.0.0.1:5432/spotidata

# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Spotify app.
# `localhost` is banned by Spotify — the loopback IP literal is the only
# non-HTTPS exception. Register both the dev and preview ports.
#   http://127.0.0.1:5173/auth/callback   (vite dev)
#   http://127.0.0.1:4173/auth/callback   (preview / adapter-node)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

# "embedded" runs Graphile Worker inside the SvelteKit process (default).
# "external" disables the in-process runner so `bun run worker` (Node) owns it.
# "off" disables background job processing entirely.
WORKER_MODE=embedded
WORKER_CONCURRENCY=8

# /api/mcp — read-only SQL over the Model Context Protocol. Unauthenticated by
# design: an OAuth proxy fronts the deployment. Read-only is enforced by
# Postgres (READ ONLY transaction + a role granted SELECT only), not by
# inspecting the SQL.
MCP_STATEMENT_TIMEOUT_MS=15000
# Browser origins allowed to POST there, comma-separated. Empty is right for
# every non-browser MCP client — they send no Origin — and is what stops a page
# you have open from reading the database on 127.0.0.1.
MCP_ALLOWED_ORIGINS=
