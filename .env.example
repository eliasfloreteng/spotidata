# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgres://spotidata:spotidata@127.0.0.1:5432/spotidata

# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Spotify app.
# `localhost` is banned by Spotify — the loopback IP literal is the only
# non-HTTPS exception. Register both the dev and preview ports.
#   http://127.0.0.1:5173/auth/callback   (vite dev)
#   http://127.0.0.1:4173/auth/callback   (preview / adapter-node)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

# "embedded" runs Graphile Worker inside the SvelteKit process (default).
# "external" disables the in-process runner so `bun run worker` (Node) owns it.
# "off" disables background job processing entirely.
WORKER_MODE=embedded
WORKER_CONCURRENCY=8

# Listening-history import. A Spotify extended-history archive runs to ~500 MB
# and is streamed to disk here, then deleted once read.
HISTORY_UPLOAD_DIR=
HISTORY_MAX_UPLOAD_MB=2048
# adapter-node rejects a body over 512 KB by default, before the upload handler
# ever runs. Only the /api/history/upload route needs this; vite dev ignores it.
BODY_SIZE_LIMIT=Infinity

# /api/mcp — read-only SQL over the Model Context Protocol. Unauthenticated by
# design: an OAuth proxy fronts the deployment. Read-only is enforced by
# Postgres (READ ONLY transaction + a role granted SELECT only), not by
# inspecting the SQL.
MCP_STATEMENT_TIMEOUT_MS=15000
# Browser origins allowed to POST there, comma-separated. Empty is right for
# every non-browser MCP client — they send no Origin — and is what stops a page
# you have open from reading the database on 127.0.0.1.
MCP_ALLOWED_ORIGINS=

# --- MusicBrainz / AcousticBrainz enrichment -------------------------------
# Genres, artist origins, labels and barcodes from MusicBrainz; BPM and musical
# key from AcousticBrainz. Both are open — no key, no account.
#
# MusicBrainz identifies clients by User-Agent and blocks generic ones, so this
# contact (a URL or an email that reaches you) is the one required setting.
MUSICBRAINZ_CONTACT=
# One request per second is MusicBrainz's published ceiling for anonymous
# clients, enforced by IP. Raising it gets the IP blocked, not served faster.
MUSICBRAINZ_RPS=1
ACOUSTICBRAINZ_RPS=2

# Optional. Enrichment is read-only and needs none of this: OAuth does not
# raise the rate limit and unlocks nothing this app reads. A grant is only what
# a future write path (submitting tags, ratings or the ISRCs we hold) needs.
# Register at https://musicbrainz.org/account/applications
MUSICBRAINZ_CLIENT_ID=
MUSICBRAINZ_CLIENT_SECRET=
MUSICBRAINZ_REDIRECT_URI=http://localhost:5173/auth/musicbrainz/callback
