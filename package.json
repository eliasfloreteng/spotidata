{
  "name": "spotidata",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun --bun ./build/index.js",
    "worker": "node --experimental-strip-types worker/main.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate && bun scripts/check-migration.ts",
    "db:migrate": "bun scripts/apply-sql.ts pre && drizzle-kit migrate && bun scripts/apply-sql.ts post && bun scripts/seed.ts",
    "db:sql": "bun scripts/apply-sql.ts pre && bun scripts/apply-sql.ts post",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bun scripts/backup.ts",
    "probe": "bun scripts/probe-api.ts",
    "setup": "bun run db:up && bun run db:migrate",
    "db:restore-auth": "bun scripts/restore-auth.ts",
    "db:reset": "bun scripts/backup.ts && docker compose down -v && docker compose up -d --wait && bun run db:migrate && bun scripts/restore-auth.ts",
    "lint:sql": "bun scripts/check-sql-conventions.ts",
    "verify": "bunx tsc --noEmit -p tsconfig.json && bun scripts/check-migration.ts && bun scripts/check-sql-conventions.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "latest",
    "@types/d3-array": "3.2.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-format": "3.0.4",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/d3-shape": "3.1.8",
    "@types/d3-time": "3.0.4",
    "@types/d3-time-format": "4.0.3",
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "1.0.0-rc.4",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-force": "3.0.0",
    "d3-format": "3.1.2",
    "d3-interpolate": "3.0.1",
    "d3-quadtree": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "graphile-worker": "0.17.3",
    "pg": "8.22.0"
  }
}
